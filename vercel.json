{
  "functions": {
    "api/*.js": {
      "includeFiles": "store/**"
    }
  },
  "rewrites": [
    {
      "source": "/product/:id",
      "destination": "/api/product?id=:id"
    },
    {
      "source": "/buy/:sku",
      "destination": "/api/buy?sku=:sku"
    },
    {
      "source": "/ship/:id",
      "destination": "/api/ship?id=:id"
    },
    {
      "source": "/unsubscribe",
      "destination": "/api/subscribe?action=unsubscribe"
    }
  ],
  "headers": [
    {
      "source": "/buy/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/ship/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/unsubscribe",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
